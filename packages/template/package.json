{
	"name": "@lift/template",
	"private": true,
	"license": "MIT",
	"author": "Nikolay Kulikov <nick@guideblade.ru>",
	"type": "module",
	"imports": {
		"#docs": "./scripts/docs/types.ts"
	},
	"scripts": {
		"dev": "node scripts/server.ts dev --host",
		"build": "astro build",
		"lift": "pnpm --filter @lift/cli lift --project .",
		"trace": "pnpm run lift libs astro trace-token decode",
		"preview": "astro build --mode preview && node scripts/server.ts preview",
		"preview:port": "pnpm run preview --port",
		"astro": "astro",
		"format": "oxfmt",
		"format:check": "pnpm run format --check",
		"lint": "node scripts/lint.ts",
		"lint:check": "pnpm run lint --check",
		"test": "node scripts/test.ts",
		"test:unit": "pnpm run test --unit",
		"test:e2e": "pnpm run test --e2e",
		"verify": "node scripts/verify.ts"
	},
	"dependencies": {
		"@zag-js/tabs": "^1.44.0",
		"@zag-js/vanilla": "^1.44.0",
		"animejs": "^4.5.0",
		"astro": "^7.4.13",
		"lenis": "^1.3.26",
		"overlayscrollbars": "^2.16.0",
		"pele": "^1.5.2",
		"sharp": "^0.35.5",
		"vue": "^3.5.45"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/compiler": "^2.13.1",
		"@astrojs/compiler-rs": "^0.5.2",
		"@astrojs/sitemap": "^3.7.4",
		"@astrojs/vue": "^7.0.2",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/node": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/qrcode": "^1.5.6",
		"jsdom": "^30.0.1",
		"markdownlint-cli2": "^0.24.2",
		"oxc-parser": "^0.151.0",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"portless": "^0.15.6",
		"postcss": "^8.5.26",
		"postcss-html": "^2.0.0",
		"postcss-scss": "^4.0.9",
		"qrcode": "^1.5.4",
		"sass": "^1.102.0",
		"stylelint": "^17.14.1",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-order": "^8.1.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "8.3.8",
		"vitest": "^4.1.10",
		"yaml": "^2.9.0",
		"zod": "^4.6.7"
	},
	"engines": {
		"node": ">=24"
	}
}
