---
import type { HTMLAttributes } from 'astro/types'
import { type BaseProps, deriveName } from '@libs/astro'
import { createBlock } from '@libs/bem'
import type { TextTag, TextVariantProps } from '../model/text'
import { componentAttributes } from '@libs/attributes'

const component = createBlock(deriveName(Astro.self))

type PropsBase = BaseProps<NonNullable<TextVariantProps['variant']>> &
	Omit<HTMLAttributes<'span'>, 'class'> & {
		tag: TextTag
		text: string
	}

type Props = PropsBase & TextVariantProps

const {
	tag: Tag,
	text,
	form = '100',
	variant = 'primary',
	class: className,
	hover,
	hoverSource,
	...props
} = Astro.props as Props
---

<Tag
	{...componentAttributes(component.block, { hover, hoverSource })}
	{...component.dataset({ form })}
	{...props}
	class:list={[component.block, component.variant(variant), className]}>
	{text}
</Tag>

<style lang="scss">
	@use '@styles/tools.scss' as *;
	@use './text.scss' as *;
	@use 'block:name' as block;

	$name: block.$name;

	@layer primitive {
		.#{$name} {
			$self: &;

			@include cq(small) {
				@include small($self);
			}
			@include cq(medium) {
				@include medium($self);
			}
			@include cq(large) {
				@include large($self);
			}
		}
	}
</style>
