---
import type { HTMLAttributes } from 'astro/types'
import { type BaseProps, deriveName } from '@libs/astro'
import { createBlock } from '@libs/bem'
import { componentAttributes } from '@libs/attributes'

const component = createBlock(deriveName(Astro.self))

type Props = BaseProps<'secondary'> &
	Omit<HTMLAttributes<'input'>, 'class' | 'type'> & {
		name?: string
		value?: string
		checked?: boolean
	}

const {
	variant = 'primary',
	name,
	value,
	checked,
	class: className,
	hover,
	hoverSource,
	...props
} = Astro.props as Props
---

<input
	type="checkbox"
	{...componentAttributes(component.block, { hover, hoverSource })}
	name={name}
	value={value}
	checked={checked}
	{...props}
	class:list={[component.block, component.variant(variant), className]}
/>

<style lang="scss">
	@use '@styles/tools.scss' as *;
	@use './checkbox.scss' as *;
	@use 'block:name' as block;

	$name: block.$name;

	@layer block {
		.#{$name} {
			$self: &;

			@include cq(small) {
				@include small($self);
			}
			@include cq(medium) {
				@include medium($self);
			}
			@include cq(large) {
				@include large($self);
			}
		}
	}
</style>
