---
import type { HTMLAttributes } from 'astro/types'
import { type BaseProps, deriveName } from '@libs/astro'
import { createBlock } from '@libs/bem'
import { componentAttributes, instanceAttributes } from '@libs/attributes'
import { elementTag } from '@libs/instance'
import Text from '@primitives/text'
import type { DiagramContent } from '../model/diagram'
import { renderDiagram } from '../lib/renderDiagram'

const component = createBlock(deriveName(Astro.self))
const Tag = elementTag(component.block)

type Props = BaseProps<'secondary' | 'tertiary'> &
	Omit<HTMLAttributes<'div'>, 'class'> &
	DiagramContent

const {
	variant = 'primary',
	source,
	zoom = 'auto',
	class: className,
	hover,
	hoverSource,
	...props
} = Astro.props as Props

const diagram = renderDiagram(source)
---

<Tag
	{...componentAttributes(component.block, { hover, hoverSource })}
	{...instanceAttributes(component.block, { requiresJs: false })}
	{...component.dataset({ source, zoom })}
	{...props}
	class:list={[component.block, component.variant(variant), className]}>
	<div class:list={component.element('stage')} {...component.dataset({ stage: '' })}>
		{'svg' in diagram ? (
			<Fragment set:html={diagram.svg} />
		) : (
			<Text tag="p" text={diagram.error} class:list={['pele pele-error']} />
		)}
	</div>
</Tag>

<script>
	import '../InstanceDiagram'
</script>

<style lang="scss">
	@use '@styles/tools.scss' as *;
	@use './diagram.scss' as *;
	@use 'block:name' as block;

	$name: block.$name;

	@layer block {
		.#{$name} {
			$self: &;

			@include cq(small) {
				@include small($self);
			}
			@include cq(medium) {
				@include medium($self);
			}
			@include cq(large) {
				@include large($self);
			}
		}
	}
</style>
