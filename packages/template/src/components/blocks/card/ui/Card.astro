---
import type { HTMLAttributes } from 'astro/types'
import { type BaseProps, deriveName } from '@libs/astro'
import { createBlock } from '@libs/bem'
import type { CardContent } from '../model/card'
import { componentAttributes } from '@libs/attributes'

const component = createBlock(deriveName(Astro.self))

type Props = BaseProps & Omit<HTMLAttributes<'article'>, 'class'> & CardContent

const {
	variant = 'primary',
	class: className,
	sampleSlots,
	hover,
	hoverSource = true,
	...props
} = Astro.props as Props
const SampleDefault = sampleSlots?.default
---

<article
	{...componentAttributes(component.block, { hover, hoverSource })}
	{...props}
	class:list={[component.block, component.variant(variant), className]}>
	<slot>{SampleDefault && <SampleDefault />}</slot>
</article>

<style lang="scss">
	@use '@styles/tools.scss' as *;
	@use './card.scss' as *;
	@use 'block:name' as block;

	$name: block.$name;

	@layer block {
		.#{$name} {
			$self: &;

			@include cq(small) {
				@include small($self);
			}
			@include cq(medium) {
				@include medium($self);
			}
			@include cq(large) {
				@include large($self);
			}
		}
	}
</style>
