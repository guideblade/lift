---
import type { HTMLAttributes } from 'astro/types'
import { type BaseProps, deriveName } from '@libs/astro'
import { createBlock } from '@libs/bem'
import { componentAttributes } from '@libs/attributes'
import type { FormSimpleFormContent } from '../model/form-simple-form'

const component = createBlock(deriveName(Astro.self))

type Props = BaseProps & Omit<HTMLAttributes<'form'>, 'class'> & FormSimpleFormContent

const {
	variant = 'primary',
	class: className,
	sampleSlots,
	hover,
	hoverSource,
	...props
} = Astro.props as Props
const SampleDefault = sampleSlots?.default
---

<form
	{...componentAttributes(component.block, { hover, hoverSource })}
	class:list={[component.block, component.variant(variant), className]}
	{...props}>
	<slot>{SampleDefault && <SampleDefault />}</slot>
</form>

<style lang="scss">
	@use '@styles/tools.scss' as *;
	@use './form-simple-form.scss' as *;
	@use 'block:name' as block;

	$name: block.$name;

	@layer block {
		.#{$name} {
			$self: &;

			@include cq(small) {
				@include small($self);
			}
			@include cq(medium) {
				@include medium($self);
			}
			@include cq(large) {
				@include large($self);
			}
		}
	}
</style>
