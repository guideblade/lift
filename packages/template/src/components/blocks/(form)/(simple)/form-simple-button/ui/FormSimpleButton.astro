---
import type { HTMLAttributes } from 'astro/types'
import { type BaseProps, deriveName } from '@libs/astro'
import { createBlock } from '@libs/bem'
import { componentAttributes } from '@libs/attributes'
import type { FormSimpleButtonContent } from '../model/form-simple-button'

const component = createBlock(deriveName(Astro.self))

type Props = BaseProps & Omit<HTMLAttributes<'div'>, 'class'> & FormSimpleButtonContent

const {
	variant = 'primary',
	class: className,
	sampleSlots,
	hover,
	hoverSource,
	...props
} = Astro.props as Props
const SampleButton = sampleSlots?.button
---

<div
	{...componentAttributes(component.block, { hover, hoverSource })}
	{...props}
	class:list={[component.block, component.variant(variant), className]}>
	<slot name="button">{SampleButton && <SampleButton />}</slot>
</div>

<style lang="scss">
	@use '@styles/tools.scss' as *;
	@use './form-simple-button.scss' as *;
	@use 'block:name' as block;

	$name: block.$name;

	@layer block {
		.#{$name} {
			$self: &;

			@include cq(small) {
				@include small($self);
			}
			@include cq(medium) {
				@include medium($self);
			}
			@include cq(large) {
				@include large($self);
			}
		}
	}
</style>
