---
import type { HTMLAttributes } from 'astro/types'
import { type BaseProps, deriveName } from '@libs/astro'
import { createBlock } from '@libs/bem'
import { elementTag } from '@libs/instance'
import { componentAttributes, instanceAttributes } from '@libs/attributes'
import type { AccordionContent } from '../model/accordion'
import Text from '@primitives/text'

const component = createBlock(deriveName(Astro.self))
const Tag = elementTag(component.block)

type Props = BaseProps &
	Omit<HTMLAttributes<'div'>, 'class'> &
	Pick<HTMLAttributes<'details'>, 'name' | 'open'> &
	AccordionContent

const {
	variant = 'primary',
	summary,
	name,
	open,
	class: className,
	sampleSlots,
	hover,
	hoverSource,
	...props
} = Astro.props as Props
const SampleDefault = sampleSlots?.default
---

<Tag
	{...componentAttributes(component.block, { hover, hoverSource })}
	{...instanceAttributes(component.block, { requiresJs: false })}
	class:list={[component.block, component.variant(variant), className]}
	{...props}>
	<details class={component.element('details')} name={name} open={open}>
		<summary class={component.element('summary')}>
			<Text tag="span" text={summary} />
		</summary>
		<div class={component.element('inner')}>
			<slot>{SampleDefault && <SampleDefault />}</slot>
		</div>
	</details>
</Tag>

<script>
	import '../InstanceAccordion'
</script>

<style lang="scss">
	@use '@styles/tools.scss' as *;

	@use './accordion.scss' as *;
	@use 'block:name' as block;

	$name: block.$name;

	@layer block {
		.#{$name} {
			$self: &;

			@include cq(small) {
				@include small($self);
			}

			@include cq(medium) {
				@include medium($self);
			}

			@include cq(large) {
				@include large($self);
			}
		}
	}
</style>
