---
import type { ComponentProps } from 'astro/types'
import Label from '@primitives/label'
import Input from '@primitives/input'
import Descriptor from '@blocks/descriptor'

type BaseProps = ComponentProps<typeof Label>

type Props = Partial<BaseProps> & {
	value?: string
	descriptor?: string
}

const { value, descriptor, ...props } = Astro.props as Props
---

<Label variant="secondary" {...props}>
	<Descriptor text={descriptor} />
	<Input variant="secondary" value={value} />
</Label>
