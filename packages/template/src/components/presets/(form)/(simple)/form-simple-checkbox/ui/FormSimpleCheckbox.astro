---
import type { ComponentProps } from 'astro/types'
import FormSimpleCheckbox from '@blocks/(form)/(simple)/form-simple-checkbox'
import Checkbox from '@blocks/checkbox'

type Props = Omit<ComponentProps<typeof Checkbox>, 'variant'> & {
	variant?: ComponentProps<typeof FormSimpleCheckbox>['variant']
}

const { variant, class: className, ...props } = Astro.props as Props
---

<FormSimpleCheckbox variant={variant} class:list={[className]}>
	<Fragment slot="checkbox">
		<Checkbox variant="secondary" {...props} />
	</Fragment>
	<slot />
</FormSimpleCheckbox>
