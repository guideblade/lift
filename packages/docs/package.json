{
	"name": "@lift/docs",
	"private": true,
	"license": "MIT",
	"author": "Nikolay Kulikov <nick@guideblade.ru>",
	"type": "module",
	"scripts": {
		"dev": "portless run vitepress dev",
		"build": "vitepress build",
		"preview": "vitepress preview",
		"check": "tsc --noEmit",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint --fix --deny-warnings && pnpm run lint:md --fix",
		"lint:check": "oxlint --deny-warnings && pnpm run lint:md",
		"lint:md": "markdownlint-cli2",
		"verify": "pnpm run format:check && pnpm run check && pnpm run lint:check && pnpm run build"
	},
	"dependencies": {
		"vitepress": "^1.6.4",
		"vue": "^3.5.45"
	},
	"devDependencies": {
		"@types/node": "^24.13.6",
		"markdownlint-cli2": "^0.24.2",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"portless": "^0.15.6",
		"sass": "^1.102.0",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": ">=24"
	}
}
